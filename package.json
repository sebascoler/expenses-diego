{
  "name": "expenses-diego",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "pnpm db:migrate && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "fixtures:generate": "tsx fixtures/generate.ts",
    "user:create": "tsx --conditions=react-server scripts/user-create.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/user-reset-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@electric-sql/pglite": "0.5.15",
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "@react-pdf/renderer": "4.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ],
    "overrides": {
      "uuid": "11.1.1"
    }
  }
}
